    {
      "parameters": {
        "jsCode": "const fields = $json.body.data.fields;\n\nconst lead = {};\nconst optionMap = {};\n\n// Build option ID -> text map\nfor (const field of fields) {\n  if (field.options) {\n    for (const option of field.options) {\n      optionMap[option.id] = option.text;\n    }\n  }\n}\n\n// Extract values\nfor (const field of fields) {\n  let value = field.value;\n\n  if (Array.isArray(value)) {\n    value = value.map(v => optionMap[v] || v).join(\", \");\n  }\n\n  lead[field.label] = value;\n}\n\nreturn [{\n  json: {\n    name: lead[\"Full Name\"] || \"\",\n    email: lead[\"Email Address\"] || \"\",\n    phone: lead[\"Phone number\"] || \"\",\n    company: lead[\"Company Name\"] || \"\",\n    service: lead[\"Which service do you need?\"] || \"\",\n    budget: lead[\"Estimated Budget\"] || \"\",\n    message: lead[\"Tell us about your project\"] || \"\"\n  }\n}];"
      },
