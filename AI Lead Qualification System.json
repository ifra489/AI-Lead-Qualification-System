    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a senior sales consultant for a software development agency.\n\nAnalyze each lead like an experienced business development manager.\n\nConsider:\n- Service requested\n- Budget\n- Company information\n- Project description\n\nScoring Rules:\n- High: Budget is More than $3000 and requirements are clear.\n- Warm: Budget is between $1000 and $3000 with reasonably clear requirements.\n- Low: Budget is below $1000 or requirements are unclear.\n\nReturn ONLY valid JSON.\n\nThe \"reason\" should be specific to the lead. Do not repeat the scoring rules.\n\nThe \"next_action\" should be a practical business action, not a generic sentence.\n\nExample:\n\n{\n  \"lead_score\": \"Warm\",\n  \"reason\": \"The lead is looking for website development with a mid-range budget and has provided enough information to begin a technical discussion.\",\n  \"next_action\": \"Schedule a discovery call within 24 hours, gather detailed requirements, and prepare a preliminary project estimate.\"\n}",
        "messages": {
          "messageValues": [
            {
              "type": "=SystemMessagePromptTemplate",
              "message": "=You are a sales assistant.\n\nAnalyze this lead.\n\nName: {{ $json.name }}\nCompany: {{ $json.company }}\nService: {{ $json.service }}\nBudget: {{ $json.budget }}\nMessage: {{ $json.message }}\n\nReturn only JSON.\n\n{\n \"lead_score\":\"\",\n \"reason\":\"\",\n \"next_action\":\"\"\n}"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
